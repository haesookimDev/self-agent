NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://continuum:continuum@localhost:5432/continuum
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=continuum-files
S3_ACCESS_KEY=continuum
S3_SECRET_KEY=change-me

# Local development only. Production startup rejects this setting.
AUTH_DISABLED=true

# Required when AUTH_DISABLED=false
OIDC_ISSUER=http://localhost:8080/realms/continuum
OIDC_AUDIENCE=continuum-api
OIDC_JWKS_URL=http://localhost:8080/realms/continuum/protocol/openid-connect/certs
